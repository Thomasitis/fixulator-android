<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fx_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fx_widget_bg_off"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/fx_widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FIXULATOR"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

    <TextView
        android:id="@+id/fx_widget_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OFF"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/fx_widget_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="tap to switch"
        android:textColor="#CCFFFFFF"
        android:textSize="10sp" />
</LinearLayout>
